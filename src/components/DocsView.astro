---
import {
  DEFAULT_LANG,
  LANGS,
  docRoutePath,
  getMapping,
  normalize,
  type FlatDoc,
} from "../utils/docs";

export interface Props {
  activeView?: string;
  docPath?: string;
  defaultHtml?: string;
  i18nData?: Record<string, string>;
  availableLangs?: string[];
  flat?: FlatDoc[];
  currentTitle?: string;
  prev?: FlatDoc | null;
  next?: FlatDoc | null;
}

const {
  activeView = "home",
  docPath = "",
  defaultHtml = "",
  i18nData = {},
  availableLangs = [],
  flat = [],
  currentTitle = "",
  prev = null,
  next = null,
} = Astro.props;

// 侧边栏导航树（默认语言）
const mapping = getMapping(DEFAULT_LANG);
const categories = (mapping?.categories ?? {}) as Record<string, any>;

// 按分类分组文档，供侧边栏渲染
const langOptions: { value: string; label: string }[] = [
  { value: "zh-CN", label: "简体中文" },
  { value: "en", label: "English" },
  { value: "zh-TW", label: "繁體中文" },
  { value: "ja", label: "日本語" },
  { value: "ru", label: "Русский" },
];

const currentNorm = normalize(docPath);

// GitHub 编辑链接
const editUrl = `https://github.com/ErisPulse/ErisPulse/edit/Develop/v2/docs/${DEFAULT_LANG}/${docPath}.md`;
---

<div
  id="docs-view"
  class={`view-container ${activeView === "docs" ? "active" : ""}`}
  data-doc-path={docPath}
>
  <div class="container">
    <div class="docs-layout">
      <!-- 左侧导航栏 -->
      <aside class="docs-sidebar">
        <div class="docs-sidebar-header">
          <!-- 语言切换器 -->
          <div class="docs-language-switcher">
            <div class="lang-select-wrapper">
              <select id="lang-select" class="lang-select">
                {
                  langOptions.map((opt) => (
                    <option value={opt.value} selected={opt.value === DEFAULT_LANG}>
                      {opt.label}
                    </option>
                  ))
                }
              </select>
            </div>
          </div>
          <!-- 搜索入口（Pagefind） -->
          <button id="docs-search-btn" class="docs-search-trigger" type="button">
            <i class="fas fa-search"></i>
            <span data-i18n="docs.search">搜索文档</span>
          </button>
        </div>
        <nav class="docs-nav-container" id="docs-nav">
          {
            Object.entries(categories).map(([catName, cat]) => (
              <div class="docs-nav-category" data-category={catName}>
                <button class="docs-nav-cat-btn" type="button">
                  <i class="fas fa-folder" />
                  <span>{catName}</span>
                  <i class="fas fa-chevron-down docs-nav-arrow" />
                </button>
                <ul class="docs-nav-docs">
                  {(cat.documents ?? []).map((d: any) => {
                    const dNorm = normalize(d.path.replace(/^docs\//, ""));
                    const href = docRoutePath(d.path);
                    return (
                      <li>
                        <a
                          href={href}
                          class={`docs-nav-link ${dNorm === currentNorm ? "active" : ""}`}
                        >
                          {d.title}
                        </a>
                      </li>
                    );
                  })}
                  {Object.entries(cat.subgroups ?? {}).map(([sgKey, sg]: [string, any]) => (
                    <li class="docs-nav-subgroup">
                      <div class="docs-nav-sg-title">{sg.name ?? sgKey}</div>
                      <ul>
                        {(sg.documents ?? []).map((d: any) => {
                          const dNorm = normalize(d.path.replace(/^docs\//, ""));
                          const href = docRoutePath(d.path);
                          return (
                            <li>
                              <a
                                href={href}
                                class={`docs-nav-link sub ${dNorm === currentNorm ? "active" : ""}`}
                              >
                                {d.title}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      <!-- 主内容区域 -->
      <main class="docs-main">
        <!-- 面包屑导航 -->
        <nav class="docs-breadcrumb">
          <a href="/docs" data-i18n="docs.title">文档中心</a>
          <span class="separator">/</span>
          <span class="current">{currentTitle}</span>
        </nav>

        <!-- 文档操作栏 -->
        <div class="docs-actions">
          <a href={editUrl} class="docs-action-btn" target="_blank" rel="noopener">
            <i class="fas fa-edit"></i>
            <span data-i18n="docs.edit">编辑此页</span>
          </a>
          <button class="docs-action-btn" id="docs-share-btn" type="button">
            <i class="fas fa-share-alt"></i>
            <span data-i18n="docs.share">分享</span>
          </button>
        </div>

        <!-- 文档内容（构建期渲染的默认语言 HTML） -->
        <article class="markdown-content" id="docs-content" set:html={defaultHtml} />

        <!-- 章节目录（客户端注入） -->
        <aside class="docs-toc" id="docs-toc"></aside>

        <!-- 上一篇 / 下一篇 -->
        <nav class="docs-prevnext">
          {
            prev && (
              <a class="docs-prev" href={docRoutePath(prev.path)}>
                <span class="docs-prevnext-label">
                  <i class="fas fa-arrow-left" /> 上一篇
                </span>
                <span class="docs-prevnext-title">{prev.title}</span>
              </a>
            )
          }
          {
            next && (
              <a class="docs-next" href={docRoutePath(next.path)}>
                <span class="docs-prevnext-label">
                  下一篇 <i class="fas fa-arrow-right" />
                </span>
                <span class="docs-prevnext-title">{next.title}</span>
              </a>
            )
          }
        </nav>
      </main>
    </div>
  </div>
</div>

<!-- 多语言数据（客户端切换用） -->
<script
  type="application/json"
  id="docs-i18n-data"
  set:html={JSON.stringify(i18nData)}
></script>

<script>
  import Chart from "chart.js/auto";
  import mermaid from "mermaid";

  // ===== 语言切换（单路径 i18n）=====
  function getCurrentLang(): string {
    return localStorage.getItem("erispulse-lang") || "zh-CN";
  }

  function applyDocLang(lang: string) {
    const dataEl = document.getElementById("docs-i18n-data");
    const content = document.getElementById("docs-content");
    if (!dataEl || !content) return;
    let data: Record<string, string> = {};
    try {
      data = JSON.parse(dataEl.textContent || "{}");
    } catch {
      return;
    }
    const html = data[lang];
    if (!html) return;
    content.innerHTML = html;
    postRender(lang);
  }

  function postRender(_lang: string) {
    // Prism 高亮
    document
      .querySelectorAll<HTMLElement>("#docs-content pre code:not(.language-mermaid)")
      .forEach((block) => {
        if (!block.className || !block.className.startsWith("language-")) {
          block.classList.add("language-python");
        }
        if ((window as any).Prism) (window as any).Prism.highlightElement(block);
      });

    // Mermaid
    if ((window as any).mermaid) {
      (window as any).mermaid.init(
        undefined,
        document.querySelectorAll(".language-mermaid"),
      );
    }

    rebuildToc();
    interceptContentLinks();
  }

  // ===== 章节目录（从 h2/h3 生成）=====
  function rebuildToc() {
    const toc = document.getElementById("docs-toc");
    if (!toc) return;
    const headings = document.querySelectorAll<HTMLElement>(
      "#docs-content h2, #docs-content h3",
    );
    if (headings.length < 2) {
      toc.innerHTML = "";
      return;
    }
    let html = '<div class="docs-toc-title">本页内容</div><ul>';
    headings.forEach((h) => {
      const id = h.id || h.textContent?.trim() || "";
      const cls = h.tagName === "H2" ? "toc-h2" : "toc-h3";
      html += `<li class="${cls}"><a href="#${id}">${h.textContent}</a></li>`;
    });
    html += "</ul>";
    toc.innerHTML = html;
  }

  // ===== 文档内链接拦截（相对链接 → 站内路由）=====
  function interceptContentLinks() {
    document.querySelectorAll<HTMLAnchorElement>("#docs-content a[href]").forEach((link) => {
      const href = link.getAttribute("href") || "";
      // 页内锚点
      if (href.startsWith("#")) {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const el = document.getElementById(href.slice(1));
          if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
        });
        return;
      }
      // 相对 .md 链接 → /docs/ 路由
      if (!href.startsWith("http") && (href.endsWith(".md") || href.includes(".md#"))) {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          let p = href.split("#")[0];
          if (p.endsWith("/README.md")) p = p.replace("/README.md", "");
          p = p.replace(/\.md$/, "");
          window.location.href = "/docs/" + p.replace(/^\.?\//, "");
        });
      }
    });
  }

  // ===== 侧边栏折叠 =====
  function setupSidebar() {
    document.querySelectorAll<HTMLButtonElement>(".docs-nav-cat-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.closest(".docs-nav-category");
        cat?.classList.toggle("collapsed");
      });
    });
  }

  // ===== 分享 =====
  function setupShare() {
    const btn = document.getElementById("docs-share-btn");
    btn?.addEventListener("click", async () => {
      const url = window.location.href;
      const title = document.title;
      if (navigator.share) {
        try {
          await navigator.share({ title, url });
        } catch {
          /* 用户取消 */
        }
      } else {
        await navigator.clipboard.writeText(url);
        btn.classList.add("copied");
        setTimeout(() => btn.classList.remove("copied"), 1500);
      }
    });
  }

  // ===== Pagefind 搜索 =====
  // Pagefind UI 的 CSS/JS 由构建后的 /pagefind/ 目录提供
  function setupSearch() {
    const btn = document.getElementById("docs-search-btn");
    if (!btn) return;
    let loaded = false;
    btn.addEventListener("click", async () => {
      const modal = document.getElementById("docs-search-modal");
      if (!loaded) {
        // 动态加载 pagefind-ui（构建产物，需对打包器隐藏静态路径）
        await new Promise((resolve, reject) => {
          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = "/pagefind/pagefind-ui.css";
          link.onload = resolve;
          link.onerror = reject;
          document.head.appendChild(link);
        });
        // 运行时拼接路径，避免 Vite/Rollup 静态分析
        const pfBase = "/" + "pagefind/";
        await import(/* @vite-ignore */ pfBase + "pagefind-ui.js");
        new window.PagefindUI({
          element: "#pagefind-search",
          baseUrl: pfBase,
        });
        loaded = true;
      }
      modal?.classList.add("open");
      const input = modal?.querySelector<HTMLInputElement>("input");
      input?.focus();
    });
    document.getElementById("docs-search-close")?.addEventListener("click", () => {
      document.getElementById("docs-search-modal")?.classList.remove("open");
    });
  }

  // ===== 语言下拉同步 =====
  function syncLangSelect() {
    const sel = document.getElementById("lang-select") as HTMLSelectElement | null;
    if (!sel) return;
    sel.value = getCurrentLang();
    sel.addEventListener("change", () => {
      const lang = sel.value;
      localStorage.setItem("erispulse-lang", lang);
      applyDocLang(lang);
    });
    // 如果用户语言不是默认语言，切换内容
    const lang = getCurrentLang();
    if (lang !== "zh-CN") applyDocLang(lang);
  }

  // ===== 初始化 =====
  document.addEventListener("astro:page-load", init);
  if (document.readyState !== "loading") init();
  else document.addEventListener("DOMContentLoaded", init);

  function init() {
    syncLangSelect();
    setupSidebar();
    setupShare();
    setupSearch();
    postRender(getCurrentLang());
  }
</script>

<!-- Pagefind 搜索弹窗 -->
<div class="docs-search-modal" id="docs-search-modal">
  <div class="docs-search-modal-card">
    <button id="docs-search-close" class="docs-search-close" type="button">
      <i class="fas fa-times"></i>
    </button>
    <div id="pagefind-search"></div>
  </div>
</div>

<style>
  .docs-search-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text-secondary);
    cursor: pointer;
    font-size: 0.85rem;
    margin-top: 0.5rem;
    transition: var(--transition);
  }
  .docs-search-trigger:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  /* 侧边栏分类折叠 */
  .docs-nav-category .docs-nav-docs {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .docs-nav-cat-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.55rem 0.4rem;
    border: none;
    background: transparent;
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
    border-radius: 6px;
  }
  .docs-nav-cat-btn:hover {
    background: var(--bg);
  }
  .docs-nav-arrow {
    margin-left: auto;
    font-size: 0.7rem;
    transition: transform 0.2s;
  }
  .docs-nav-category.collapsed .docs-nav-docs {
    display: none;
  }
  .docs-nav-category.collapsed .docs-nav-arrow {
    transform: rotate(-90deg);
  }
  .docs-nav-link {
    display: block;
    padding: 0.4rem 0.7rem 0.4rem 1.5rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.83rem;
    border-radius: 6px;
    transition: var(--transition);
  }
  .docs-nav-link:hover {
    background: var(--bg);
    color: var(--primary);
  }
  .docs-nav-link.active {
    background: rgba(var(--primary-rgb), 0.1);
    color: var(--primary);
    font-weight: 600;
  }
  .docs-nav-link.sub {
    padding-left: 2.4rem;
    font-size: 0.8rem;
  }
  .docs-nav-sg-title {
    padding: 0.4rem 0.7rem 0.2rem 1.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-secondary);
    opacity: 0.8;
  }

  /* 章节目录 */
  .docs-toc {
    margin: 2rem 0;
    padding: 1rem 1.2rem;
    background: var(--bg);
    border-radius: var(--radius);
    border-left: 3px solid var(--primary);
  }
  .docs-toc:empty {
    display: none;
  }
  .docs-toc-title {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }
  .docs-toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .docs-toc .toc-h2 a {
    font-size: 0.83rem;
    color: var(--text);
  }
  .docs-toc .toc-h3 a {
    font-size: 0.78rem;
    color: var(--text-secondary);
    padding-left: 1rem;
  }
  .docs-toc a {
    text-decoration: none;
    display: block;
    padding: 0.2rem 0;
  }
  .docs-toc a:hover {
    color: var(--primary);
  }

  /* 上一篇 / 下一篇 */
  .docs-prevnext {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 2.5rem 0 1rem;
  }
  .docs-prev,
  .docs-next {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text);
    flex: 1;
    transition: var(--transition);
    max-width: 48%;
  }
  .docs-prev:hover,
  .docs-next:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-card);
  }
  .docs-next {
    text-align: right;
  }
  .docs-prevnext-label {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }
  .docs-prevnext-title {
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* 搜索弹窗 */
  .docs-search-modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1200;
    align-items: flex-start;
    justify-content: center;
    padding: 5vh 1rem;
  }
  .docs-search-modal.open {
    display: flex;
  }
  .docs-search-modal-card {
    position: relative;
    background: var(--card-bg);
    border-radius: var(--radius);
    box-shadow: var(--shadow-hover);
    width: 100%;
    max-width: 640px;
    padding: 1.5rem;
  }
  .docs-search-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    border: none;
    background: var(--bg);
    width: 32px;
    height: 32px;
    border-radius: 8px;
    cursor: pointer;
    color: var(--text-secondary);
  }
  .docs-action-btn.copied {
    color: var(--accent);
  }
</style>

<script>
  import Chart from "chart.js/auto";
  import mermaid from "mermaid";

  window.Chart = Chart;
  window.mermaid = mermaid;
</script>
